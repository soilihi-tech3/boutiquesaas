# ==========================================
# VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# ==========================================

# Port d'écoute du serveur Node.js
PORT=4000

# Base de Données TiDB Cloud / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=easyshop
DB_USER=root
DB_PASSWORD=

# Sécurité & Authentification JWT
JWT_SECRET=votre_cle_secrete_ultra_securisee_en_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Service d'envoi d'e-mails Brevo (API REST v3)
BREVO_API_KEY=xkeysib-votre_cle_api_brevo_ici
BREVO_SENDER_EMAIL=soilihiabdou99@gmail.com
BREVO_SENDER_NAME=EasyMarket

# Service d'envoi d'e-mails Gmail (Fallback optionnel)
GMAIL_USER=soilihiabdou99@gmail.com
GMAIL_APP_PASS=votre_mot_de_passe_application_gmail

# Intégration Stripe (Clés de Production ou Test)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Intégration PayTech — Wave & Orange Money ────────────────────────────────
# Créez votre compte sur https://paytech.sn, puis récupérez vos clés dans :
# Paramètres → API & APN
PAYTECH_API_KEY=votre_cle_api_paytech
PAYTECH_API_SECRET=votre_cle_secrete_paytech
# Environnement PayTech : "test" pour les tests, "prod" pour la production
PAYTECH_ENV=test
# URL publique du backend (pour que PayTech puisse appeler votre IPN)
# En développement local : utilisez ngrok → ngrok http 4000
# En production : votre URL Render, Railway, etc.
BACKEND_URL=https://comoresbiachara.onrender.com
